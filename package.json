{
  "name": "dsh-subagent-omp",
  "description": "One-shot OMP subagent provider: each delegation spawns the local `omp --print --mode json` CLI, which runs with the user's own ~/.omp configuration and model bindings; runs are serialized so a single-session local engine is never oversubscribed",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "vendor/out-of-process.js",
    "vendor/types.js",
    "vendor/node_modules/@deepseek-ai/schemastery",
    "vendor/node_modules/@deepseek-ai/cosmokit",
    "vendor/node_modules/@deepseek-ai/dsh-brand",
    "CHANGELOG.md",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "subagent",
    "agent-team",
    "omp",
    "oh-my-pi",
    "local-model"
  ],
  "author": "MYCAIGC",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tool-subagent": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feigo313/dsh-subagent-omp.git"
  },
  "homepage": "https://github.com/feigo313/dsh-subagent-omp#readme",
  "bugs": {
    "url": "https://github.com/feigo313/dsh-subagent-omp/issues"
  },
  "scripts": {
    "test": "node test/provider.test.mjs && node test/edge-cases.test.mjs"
  }
}
